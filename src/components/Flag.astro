---
interface Props { name: string }
const { name } = Astro.props;
---

{name === 'nunavut' && (
  <svg viewBox="0 0 60 40" preserveAspectRatio="none" aria-hidden="true">
    <rect width="30" height="40" fill="#FECB2F" />
    <rect x="30" width="30" height="40" fill="#F5F1E8" />
    <g fill="#C8102E">
      <rect x="28" y="12" width="4" height="3" />
      <rect x="20" y="16" width="20" height="4" />
      <rect x="23" y="21" width="3" height="8" />
      <rect x="34" y="21" width="3" height="8" />
      <rect x="21" y="29" width="7" height="3" />
      <rect x="32" y="29" width="7" height="3" />
    </g>
    <polygon
      points="48,6 49,9 52,9 49.5,11 50.5,14 48,12 45.5,14 46.5,11 44,9 47,9"
      fill="#2A4D8E"
    />
  </svg>
)}

{name === 'us' && (
  <svg viewBox="0 0 60 40" preserveAspectRatio="none" aria-hidden="true">
    <rect width="60" height="40" fill="#F5F1E8" />
    <g fill="#B22234">
      <rect y="0" width="60" height="3.08" />
      <rect y="6.15" width="60" height="3.08" />
      <rect y="12.31" width="60" height="3.08" />
      <rect y="18.46" width="60" height="3.08" />
      <rect y="24.62" width="60" height="3.08" />
      <rect y="30.77" width="60" height="3.08" />
      <rect y="36.92" width="60" height="3.08" />
    </g>
    <rect width="24" height="21.54" fill="#2A4D8E" />
    <g fill="#F5F1E8">
      <circle cx="4" cy="4" r="0.9" />
      <circle cx="10" cy="4" r="0.9" />
      <circle cx="16" cy="4" r="0.9" />
      <circle cx="7" cy="8" r="0.9" />
      <circle cx="13" cy="8" r="0.9" />
      <circle cx="19" cy="8" r="0.9" />
      <circle cx="4" cy="12" r="0.9" />
      <circle cx="10" cy="12" r="0.9" />
      <circle cx="16" cy="12" r="0.9" />
      <circle cx="7" cy="16" r="0.9" />
      <circle cx="13" cy="16" r="0.9" />
      <circle cx="19" cy="16" r="0.9" />
    </g>
  </svg>
)}

{name === 'france' && (
  <svg viewBox="0 0 60 40" preserveAspectRatio="none" aria-hidden="true">
    <rect width="20" height="40" fill="#0055A4" />
    <rect x="20" width="20" height="40" fill="#F5F1E8" />
    <rect x="40" width="20" height="40" fill="#EF4135" />
  </svg>
)}

{name === 'sweden' && (
  <svg viewBox="0 0 60 40" preserveAspectRatio="none" aria-hidden="true">
    <rect width="60" height="40" fill="#0060A8" />
    <rect y="17" width="60" height="6" fill="#FFCC33" />
    <rect x="17" width="6" height="40" fill="#FFCC33" />
  </svg>
)}
