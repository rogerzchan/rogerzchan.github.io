---
interface Props { name: string }
const { name } = Astro.props;
---

{name === 'truck' && (
  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="10" width="14" height="10" rx="1" />
    <path d="M17 13h5l3 3v4h-8z" />
    <circle cx="8" cy="23" r="2" />
    <circle cx="21" cy="23" r="2" />
    <path d="M6 7l1 -2M10 7l1 -2M14 7l1 -2" />
  </svg>
)}

{name === 'inukshuk' && (
  <svg viewBox="0 0 32 32" fill="currentColor" stroke="none" aria-hidden="true">
    <rect x="13" y="6" width="6" height="3.2" rx="0.4" />
    <rect x="5" y="11.5" width="22" height="3" rx="0.4" />
    <rect x="9" y="17" width="4" height="6" rx="0.4" />
    <rect x="19" y="17" width="4" height="6" rx="0.4" />
    <rect x="7" y="25" width="8" height="3" rx="0.4" />
    <rect x="17" y="25" width="8" height="3" rx="0.4" />
  </svg>
)}

{name === 'phone' && (
  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="9" y="4" width="14" height="24" rx="2" />
    <circle cx="16" cy="24" r="0.75" fill="currentColor" stroke="none" />
    <path d="M13 8h6" />
  </svg>
)}

{name === 'chart' && (
  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 26V6M4 26h24" />
    <path d="M8 22l5 -7l5 4l6 -10" />
  </svg>
)}

{name === 'brain' && (
  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 6c-3 0 -5 2 -5 5c-2 1 -2 4 0 5c-1 2 0 5 3 5c0 2 2 3 4 3c1 0 2 -0.5 2 -2V6c0 -1 -1 -1.5 -2 -1.5c-1 0 -2 0.5 -2 1.5z" />
    <path d="M20 6c3 0 5 2 5 5c2 1 2 4 0 5c1 2 0 5 -3 5c0 2 -2 3 -4 3c-1 0 -2 -0.5 -2 -2V6c0 -1 1 -1.5 2 -1.5c1 0 2 0.5 2 1.5z" />
  </svg>
)}

{name === 'code' && (
  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M11 10l-6 6l6 6" />
    <path d="M21 10l6 6l-6 6" />
    <path d="M18 6l-4 20" />
  </svg>
)}

{name === 'database' && (
  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <ellipse cx="16" cy="7" rx="10" ry="3" />
    <path d="M6 7v18c0 1.7 4.5 3 10 3s10 -1.3 10 -3V7" />
    <path d="M6 15c0 1.7 4.5 3 10 3s10 -1.3 10 -3" />
  </svg>
)}
